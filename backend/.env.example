PORT=5000
NODE_ENV=production

# Where your React app lives (no trailing slash). Used for CORS + redirects.
# Optional: other addresses allowed to call the API, comma separated (e.g. the www version)
# EXTRA_ORIGINS=https://www.yourdomain.com
FRONTEND_URL=https://YOUR-VERCEL-OR-DOMAIN-ADDRESS
# Public URL of this backend (no trailing slash). Used for the Google OAuth callback.
BACKEND_URL=https://YOUR-RENDER-OR-API-ADDRESS

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/applyly

# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
CRON_SECRET=change-me-too
# Exactly 64 hex characters (32 bytes). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Cloudinary (CV storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack (use sk_test_ keys first)
PAYSTACK_SECRET_KEY=

# Google OAuth (Gmail sending)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI for cover letters: gemini (default) or claude
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Job sources (all optional, skipped if blank). Remotive and RemoteOK need no key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
